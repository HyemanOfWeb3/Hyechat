NODE_ENV=production
PORT=5001
CLIENT_URL=https://your-app.vercel.app
MONGO_URI=your_mongodb_atlas_connection_string
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
JWT_SECRET_KEY=your_long_random_jwt_secret
EMAIL=your_smtp_email
EMAIL_PASSWORD=your_smtp_app_password
ABLY_API_KEY=your_ably_api_key
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
# Local development only; production should use the platform's attached service identity.
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-service-account.json
# For non-Google hosts, configure this JSON as a protected backend secret instead of committing a key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
TRANSLATION_MAX_AUDIO_SECONDS=60