{
  "name": "hyechat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.5",
    "lucide-react": "^1.11.0",
    "nodemailer": "^10.0.16"
  },
  "scripts": {
    "build": "cd backend && npm install && cd ../frontend && npm install --include=dev && npm run build",
    "start": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test:stories": "node --test backend/src/controllers/story.controller.test.js frontend/src/lib/storyCache.test.js",
    "test:profiles": "node --test backend/src/controllers/user.controller.test.js backend/src/lib/socialLinks.test.js frontend/src/lib/safeSocialLinks.test.js frontend/src/lib/profileSharing.test.js",
    "test:chat": "node --test frontend/src/lib/chatScrollPosition.test.js",
    "test:calls": "node --test backend/src/controllers/callHistory.controller.test.js",
    "test:security": "node --test backend/src/controllers/callHistory.controller.test.js backend/src/controllers/chat.controller.test.js backend/src/controllers/user.controller.friendRequests.test.js backend/src/controllers/user.controller.emailChange.test.js backend/src/routes/auth.route.test.js"
  }
}
